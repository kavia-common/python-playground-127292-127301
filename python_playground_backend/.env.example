# Copy these into your environment. Do not commit actual secrets.
# The orchestrator will set these in CI/runtime; this file is only illustrative.

# JWT secret key (change in production)
SECRET_KEY=replace-with-a-strong-random-string

# Token expiry (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database URL (SQLite default). For PostgreSQL: postgresql+psycopg2://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./app.db

# CORS allowed origins (comma-separated). Use '*' to allow all.
CORS_ALLOW_ORIGINS=*

# Execution sandbox limits
EXEC_TIMEOUT_SECONDS=2
EXEC_MEMORY_MB=128
